OPENAI_API_KEY=your_openai_api_key_here
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-4o-transcribe
DIARIZATION_MODEL=gpt-4o-transcribe-diarize
LOCAL_WHISPER_MODEL=large-v3-turbo
LOCAL_WHISPER_EN_MODEL=medium.en
LOCAL_WHISPER_FAST_MODEL=small
LOCAL_WHISPER_FAST_EN_MODEL=small.en
PORT=4174

# ── Auth & Sessions ────────────────────────────────────────────────
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Comma-separated list of admin emails (no spaces around commas)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Shared password that all admins must enter after their email
ADMIN_PASSWORD=replace_with_strong_password

# Your email — receives notifications when users request access or submit the contact form
OWNER_EMAIL=you@example.com

# ── Email notifications (nodemailer via Gmail SMTP) ────────────────
# Leave blank to fall back to console.log + CSV-only logging
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Use a Gmail App Password (Google Account → Security → 2-Step Verification → App Passwords)
SMTP_PASS=your_gmail_app_password
